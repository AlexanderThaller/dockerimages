# storage-bench container image
#
#   just                       build the image and load it into the engine
#   just smoke                 prove the image works against a throwaway tmpfs
#   just bench /tank/backup    benchmark a host path with the published image
#   just run /mnt/ceph /mnt/px build the image first, then benchmark those paths
#
# `bench` is the one to reach for on the machine being measured: it pulls the
# published image and needs nothing but a container engine. `run` rebuilds from
# this checkout first, which needs Nix, and is what you want while changing the
# script. Both put their reports in bench-results/ and are otherwise identical.
#
# Script tunables are read from the environment and forwarded into the
# container, so `FIO_RUNTIME=60 ORDER=by-test just bench /tank/backup` works.

image := "storage-bench"
tag := "2026-08-24-r4"

# Where `just push` sends the image when no registry is given on the command
# line. `just push quay.io/someone` still overrides it for a one-off.
default_registry := "docker.io/athallerde"

# Where `just bench` pulls from. REGISTRY overrides it for a one-off, e.g.
# `REGISTRY=quay.io/someone just bench /tank/backup`.
registry := env("REGISTRY", default_registry)

# docker or podman; override with CONTAINER_ENGINE=podman
engine := env("CONTAINER_ENGINE", "docker")

# Extra flags for `run`/`smoke`, e.g. RUN_ARGS="--cpus 4 --network none"
run_args := env("RUN_ARGS", "")

# Where `just bench` and `just run` drop their reports on the host, one
# timestamped directory per run.
results := justfile_directory() / "bench-results"

_default: help

# List the available recipes.
help:
    @just --list

# Build the image tarball with Nix (-> ./result).
build:
    nix-build --argstr name {{ image }} --argstr tag {{ tag }}

# Build, then load the image into the local container engine.
load: build
    {{ engine }} load < result

# Needs only a container engine — no Nix, no checkout of anything but this
# Justfile — which is what makes it the one to run on the storage host itself:
#
#   just bench /tank/backup
#   just bench /tank/backup /mnt/ceph        # head-to-head
#   PGBENCH=0 just bench /tank/backup        # skip the postgres workload
#
# Pulled every time so a stale local copy of the tag cannot silently be what
# gets measured.

# Benchmark host paths using the published image (no build, no Nix).
bench +hostpaths:
    {{ engine }} pull {{ registry }}/{{ image }}:{{ tag }}
    @just _run-against {{ registry }}/{{ image }}:{{ tag }} {{ hostpaths }}

# Each host path is bind-mounted at /data/<basename> and handed to the script in
# that order, so `just run /mnt/ceph /mnt/portworx` benchmarks both.

# Build the image from this checkout, then benchmark host paths with it.
run +hostpaths: load
    @just _run-against {{ image }}:{{ tag }} {{ hostpaths }}

# The body shared by `bench` and `run`; they differ only in where the image
# came from.
_run-against imageref +hostpaths:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{ results }}
    vols=() targets=() envs=()
    for p in {{ hostpaths }}; do
        [ -d "$p" ] || { echo "not a directory: $p" >&2; exit 1; }
        name="$(basename "$p")"
        # Two paths with the same basename would mount over each other at
        # /data/<name>, and the run would quietly benchmark one of them twice
        # rather than comparing the two.
        for t in "${targets[@]:-}"; do
            [ "$t" = "/data/$name" ] && {
                echo "two paths share the basename '$name' — mount one elsewhere" >&2
                exit 1
            }
        done
        vols+=(-v "$(realpath "$p"):/data/$name")
        targets+=("/data/$name")
    done
    # RUNDIR is forwarded so a run can be named rather than timestamped, e.g.
    # `RUNDIR=before-upgrade just run /mnt/ceph`.
    for v in ORDER REPEATS SETTLE DD_ZERO_MB DD_RAND_MB FIO_SIZE FIO_RUNTIME IOENGINE LOG_AVG_MSEC \
             PGBENCH PGBENCH_SCALE PGBENCH_CLIENTS PGBENCH_JOBS PGBENCH_TIME RUNDIR; do
        if [ -n "${!v:-}" ]; then envs+=(-e "$v=${!v}"); fi
    done
    # As the calling user, both because the script is meant to run unprivileged
    # and so the reports are not left root-owned. HOME must move off /root,
    # which that user cannot write.
    #
    # OUTBASE, not OUTDIR: the mount is the base, and the script puts each run
    # in its own directory underneath it, so a second run does not overwrite
    # the first.
    # --shm-size: postgres puts its dynamic shared memory segments in /dev/shm,
    # which both engines default to 64 MB. A parallel index build during the
    # pgbench load can ask for up to maintenance_work_mem and fail with "could
    # not resize shared memory segment" when it cannot get it. It survives 64 MB
    # at the default scale, but the margin is not worth the failure mode.
    {{ engine }} run --rm \
        --user "$(id -u):$(id -g)" -e HOME=/tmp \
        --shm-size=256m \
        -v {{ results }}:/out -e OUTBASE=/out \
        "${vols[@]}" "${envs[@]}" {{ run_args }} \
        {{ imageref }} "${targets[@]}"
    echo "Reports in {{ results }}/ (one directory per run)"

# Interactive shell in the image.
shell: load
    {{ engine }} run --rm -it --entrypoint bash {{ image }}:{{ tag }}

# Measures nothing useful — it exercises dd, fio, pgbench, the awk/sed parsing
# and the report generator against a container-local tmpfs. Empty RUNDIR because
# a throwaway check wants its output in one predictable place, not in a new
# timestamped directory on every invocation. pgbench is pinned to scale 5 here
# rather than the default 100: the tmpfs is RAM, and 1.6 GB of it is not what a
# smoke test should cost.

# Tiny end-to-end run to prove the image works.
smoke: load
    mkdir -p {{ results }}/smoke
    {{ engine }} run --rm \
        --user "$(id -u):$(id -g)" -e HOME=/tmp \
        --shm-size=256m \
        --tmpfs /data/a:uid=$(id -u) --tmpfs /data/b:uid=$(id -u) \
        -v {{ results }}/smoke:/out -e OUTBASE=/out -e RUNDIR= \
        -e SETTLE=0 -e DD_ZERO_MB=32 -e DD_RAND_MB=8 \
        -e FIO_SIZE=64M -e FIO_RUNTIME=2 \
        -e PGBENCH_SCALE=5 -e PGBENCH_CLIENTS=4 -e PGBENCH_JOBS=2 -e PGBENCH_TIME=5 \
        {{ run_args }} \
        {{ image }}:{{ tag }} /data/a /data/b
    @ls -l {{ results }}/smoke

# Uncompressed size of the loaded image, and of the tarball.
size: build
    @{{ engine }} image ls {{ image }}:{{ tag }}
    @echo "tarball: $(du -h --dereference result | cut -f1)"

# Both the build's own tag and `latest` are pushed, and both are tagged off the
# single image that `load` just built, so `latest` cannot end up on an older
# digest than the versioned tag:
#
#   just push                          # -> default_registry, :<tag> and :latest
#   just tag=v2 push                   # -> :v2 and :latest
#   just push quay.io/someone          # -> somewhere else, same two tags
#
# Setting tag=latest collapses the two into one push rather than pushing twice.

# Push to a registry (default: docker.io/athallerde).
push registry=default_registry: load
    #!/usr/bin/env bash
    set -euo pipefail
    tags=({{ tag }})
    [ "{{ tag }}" = latest ] || tags+=(latest)
    for t in "${tags[@]}"; do
        {{ engine }} tag {{ image }}:{{ tag }} {{ registry }}/{{ image }}:"$t"
        {{ engine }} push {{ registry }}/{{ image }}:"$t"
    done

# Drop the nix-build symlink (it is also a GC root) and the local image.
clean:
    rm -f result
    -{{ engine }} image rm {{ image }}:{{ tag }}
